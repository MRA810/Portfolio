# Cloudflare Pages + Workers static assets read this file (it is copied into dist/).

# Vite's hashed bundles never change under the same name: cache for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Images, icons and photos: cache for a week, recheck after.
/gallery/*
  Cache-Control: public, max-age=604800
/Certificates/*
  Cache-Control: public, max-age=604800
/Academic_logo/*
  Cache-Control: public, max-age=604800
/icons/*
  Cache-Control: public, max-age=604800
/logos/*
  Cache-Control: public, max-age=604800
/portrait.webp
  Cache-Control: public, max-age=604800

# Basic hardening for every response.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
